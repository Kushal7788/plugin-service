PORT=7047
RUST_LOG=mobile_tlsn_verifier_service=info,tlsn=warn
# SESSION_STORE accepts sqlite or memory. SQLite is the default; use memory for
# local dev when you do not want a DB file.
SESSION_STORE=sqlite
SESSION_STORE_SQLITE_PATH=/tmp/mobile_tlsn_verifier_sessions.sqlite3
# Active verifier sessions older than this are marked failed.
SESSION_TTL_SECONDS=600
# Session records older than this are deleted after stale sessions are marked failed.
SESSION_RETENTION_SECONDS=3600
# Hard cap for the TLSN verifier runtime after WebSocket handoff.
VERIFIER_RUN_TIMEOUT_SECONDS=600
# Hard cap for waiting on the prover WebSocket after registration.
WEBSOCKET_HANDOFF_TIMEOUT_SECONDS=60
# Base64-encoded 32-byte secp256k1 private key for notary signing
NOTARY_SIGNING_KEY_B64=REPLACE_WITH_BASE64_32_BYTE_PRIVATE_KEY
